{
  "provider": "cloudinary",
  "configuration": "verified",
  "credentialPresence": {
    "CLOUDINARY_CLOUD_NAME": "present",
    "CLOUDINARY_API_KEY": "present",
    "CLOUDINARY_API_SECRET": "present"
  },
  "dynamicFolder": true,
  "authenticatedPolicy": true,
  "rootIsRecipeHub": true,
  "timeoutMs": 15000,
  "cleanupEnabled": true,
  "productionEnvironment": false,
  "scriptConnectsDatabase": false
}
