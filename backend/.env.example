NODE_ENV=development
PORT=3000
HOST=127.0.0.1
MONGODB_URI=mongodb://127.0.0.1:27019/recipe-hub
DB_NAME=recipe-hub
LOG_LEVEL=info
DB_TIMEOUT_MS=3000
SHUTDOWN_TIMEOUT_MS=5000

# Same-origin frontend; comma-separated exact origins, no trailing slash.
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:5175,http://127.0.0.1:3000,http://localhost:3000
# Production requires HTTPS origins and a random CSRF_SECRET (>=32 characters).
# COOKIE_SECURE defaults to true for production or HTTPS origins.
# CSRF_SECRET=<set-in-your-secret-manager>
SESSION_HOURS=168
AUTH_TOKEN_MINUTES=15
CSRF_RATE_LIMIT=120
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_MS=900000
# Gmail SMTP: enable only after configuring a NEW App Password outside chat.
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# 587 is supported with required STARTTLS.
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=Recipe Hub
APP_PUBLIC_URL=http://localhost:5173
SMTP_TIMEOUT_MS=15000

# Local development only; production documentation is always disabled.
APP_DOCS_ENABLED=true
# Add the backend origin when using Swagger directly (e.g. http://127.0.0.1:3000).

# BE-08: offline private upload; existing .env is not changed.
MEDIA_PROVIDER=fake
CLOUDINARY_ASSET_FOLDER=recipe-hub
IMAGE_DELIVERY_POLICY=authenticated
IMAGE_STORAGE_TIMEOUT_MS=15000
# Real provider requires ALL four settings; inject credentials outside source control.
# CLOUDINARY_CLOUD_NAME=<cloud-name>
# CLOUDINARY_API_KEY=<api-key>
# CLOUDINARY_API_SECRET=<new-secret>
CLOUDINARY_FOLDER_MODE=dynamic
# Dynamic selected by ADR 005; real account mode still requires verification.
# Authenticated uploads return url null; live upload and private delivery remain gated.

# BE-08: private uploads only; local fake. Live Cloudinary remains gated.
MEDIA_UPLOAD_RATE_LIMIT=30
